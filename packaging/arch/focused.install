post_install() {
  cat <<'MSG'
Focused installed.

Enable and start the user service:
  systemctl --user daemon-reload
  systemctl --user enable --now focused

Then open:
  http://127.0.0.1:8766/

CLI:
  focused --help
MSG
}

post_upgrade() {
  post_install
}

pre_remove() {
  cat <<'MSG'
Removing Focused.  If anything is still suspended:
  focused --thaw-all
before removing the package.
MSG
}
