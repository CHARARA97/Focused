# Maintainer: CHARARA97 <CHARARA97@outlook.com>
pkgname=focused
pkgver=0.1.0
pkgrel=1
pkgdesc="Suspend distracting applications while you focus, and resume them after"
arch=('any')
url="https://github.com/CHARARA97/Focused"
license=('MIT')
depends=('python')
optdepends=('curl: dashboard checks in focused-doctor and focused-launch'
            'protontricks: set the winhttp override the game plugin needs')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::https://github.com/CHARARA97/Focused/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # replace with updpkgsums before pushing
install="$pkgname.install"

# The GitHub archive unpacks to <Repository>-<tag> -- here "Focused-0.1.0" -- which
# does not match $pkgname-$pkgver (the package is "focused").  Extract it ourselves
# into a fixed directory instead of depending on the archive layout.
noextract=("$pkgname-$pkgver.tar.gz")

prepare() {
  mkdir -p src
  bsdtar -xf "$srcdir/$pkgname-$pkgver.tar.gz" -C src --strip-components=1
}

build() {
  cd "$srcdir/src"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/src"
  PYTHONPATH=. python -m unittest discover -s tests -t .
}

package() {
  cd "$srcdir/src"
  python -m installer --destdir="$pkgdir" dist/*.whl

  # The systemd *user* unit, in the location packages use.  Enabling it is the
  # user's decision: a package that starts a service on install is a package that
  # suspends processes nobody asked it to touch yet.
  install -Dm644 packaging/focused.service "$pkgdir/usr/lib/systemd/user/focused.service"

  # The helper scripts the .install message and the README refer to.  They ship in
  # the release tarball, so the package must provide them or the message is a lie.
  install -Dm755 scripts/doctor-focused.sh "$pkgdir/usr/bin/focused-doctor"
  install -Dm755 scripts/launch-focused.sh "$pkgdir/usr/bin/focused-launch"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/focused.md "$pkgdir/usr/share/doc/$pkgname/focused.md"
}
