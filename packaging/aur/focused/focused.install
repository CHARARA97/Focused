post_install() {
  cat <<'EOM'
Focused is installed. To start using it:

  1) systemctl --user enable --now focused
  2) open http://127.0.0.1:8766/
  3) the first run writes ~/.config/focused/config.json (empty blacklist: it
     suspends nothing until you or a frontend says what to suspend)

Self-check, if the game plugin is also installed:
  focused-doctor

Steam launch option, so the backend is up before the game loads:
  focused-launch %command%
EOM
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl --user stop focused.service 2>/dev/null || true
}
