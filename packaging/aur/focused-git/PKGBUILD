# Maintainer: CHARARA97 <CHARARA97@outlook.com>
pkgname=focused-git
# Placeholder.  It cannot be real until the repository exists: run
#   makepkg -od && makepkg --printsrcinfo > .SRCINFO
# after the first push, then refresh pkgver occasionally (AUR convention).
pkgver=r1.a000000
pkgrel=1
pkgdesc="Suspend distracting applications while you focus (git main branch)"
arch=('any')
url="https://github.com/CHARARA97/Focused"
license=('MIT')
depends=('python')
optdepends=('curl: dashboard checks in focused-doctor and focused-launch'
            'protontricks: set the winhttp override the game plugin needs')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools')
provides=('focused')
conflicts=('focused')
source=('focused::git+https://github.com/CHARARA97/Focused.git')
sha256sums=('SKIP')

pkgver() {
  cd focused
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd focused
  python -m build --wheel --no-isolation
}

check() {
  cd focused
  PYTHONPATH=. python -m unittest discover -s tests -t .
}

package() {
  cd focused
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/focused.service "$pkgdir/usr/lib/systemd/user/focused.service"
  # The helper scripts the .install message and the README refer to.  They ship in
  # the release tarball, so the package must provide them or the message is a lie.
  install -Dm755 scripts/doctor-focused.sh "$pkgdir/usr/bin/focused-doctor"
  install -Dm755 scripts/launch-focused.sh "$pkgdir/usr/bin/focused-launch"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
